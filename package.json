{
  "name": "icon-forge",
  "type": "module",
  "version": "2.3.0",
  "private": true,
  "packageManager": "pnpm@8.15.0",
  "description": "A flexible, multi-framework icon library",
  "author": "Xiaobing Zhu <hellozxb252@gmail.com>",
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/hixb"
  },
  "homepage": "https://github.com/hixb/icon-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hixb/icon-forge.git"
  },
  "bugs": "https://github.com/hixb/icon-forge/issues",
  "keywords": [
    "icon",
    "icons",
    "icon-library",
    "svg",
    "svg-icons",
    "svg-to-component",
    "icon-generator",
    "icon-cli",
    "icon-tooling",
    "design-system",
    "ui-icons",
    "component-library",
    "monorepo",
    "turborepo",
    "typescript",
    "tree-shaking"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:icons": "tsx scripts/build-icons.ts",
    "test": "turbo run test",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^7.0.0",
    "@changesets/cli": "^2.29.8",
    "@testing-library/react": "^16.3.1",
    "@testing-library/svelte": "^5.3.1",
    "@testing-library/vue": "^8.1.0",
    "@types/node": "^25.0.8",
    "@vitest/ui": "^4.0.17",
    "eslint": "^9.39.2",
    "jsdom": "^27.4.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "turbo": "^2.7.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  }
}
