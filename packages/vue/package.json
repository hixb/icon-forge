{
  "name": "@icon-forge/vue",
  "version": "1.0.0",
  "description": "Vue components for icon-forge",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.vue"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external vue",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external vue --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@icon-forge/core": "workspace:*"
  },
  "devDependencies": {
    "@vue/runtime-core": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vue": "^3.3.0"
  }
}
