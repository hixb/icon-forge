{
  "name": "@dawnice/icon-forge-svelte",
  "version": "2.2.0",
  "description": "Svelte components for icon-forge",
  "author": "Xiaobing Zhu <hellozxb252@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hixb/icon-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hixb/icon-forge.git",
    "directory": "packages/svelte"
  },
  "bugs": "https://github.com/hixb/icon-forge/issues",
  "keywords": [
    "icon",
    "icons",
    "icon-library",
    "svelte",
    "svelte-components",
    "svg",
    "svg-icons",
    "typescript"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": "./src/icons/index.ts",
    "./icons/*": "./src/icons/*.svelte"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --external svelte",
    "dev": "tsup src/index.ts --format cjs,esm --external svelte --watch",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "svelte": "^4.0.0"
  },
  "dependencies": {
    "@dawnice/icon-forge-core": "workspace:*"
  },
  "devDependencies": {
    "svelte": "^4.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}