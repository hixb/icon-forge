{
  "name": "@icon-forge/cli",
  "version": "1.0.0",
  "description": "CLI tool for icon-forge",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "icon-forge": "./bin/cli.js"
  },
  "files": [
    "bin",
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/config-helper.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts src/config-helper.ts --format cjs,esm --dts --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@icon-forge/core": "workspace:*",
    "chalk": "^5.3.0",
    "chokidar": "^3.5.3",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "jiti": "^2.6.1",
    "ora": "^7.0.1",
    "svgo": "^3.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
