{
  "name": "@icon-forge/react",
  "version": "1.0.0",
  "description": "React components for icon-forge",
  "author": "Xiaobing Zhu <hellozxb252@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hixb/icon-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hixb/icon-forge.git",
    "directory": "packages/react"
  },
  "bugs": "https://github.com/hixb/icon-forge/issues",
  "keywords": [
    "icon",
    "icons",
    "icon-library",
    "react",
    "react-components",
    "svg",
    "svg-icons",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts --external react",
    "dev": "tsup src/index.ts --format cjs,esm --dts --external react --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "@icon-forge/core": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.8",
    "@vitejs/plugin-react": "^5.1.2",
    "jsdom": "^27.4.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
