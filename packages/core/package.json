{
  "name": "@dawnice/icon-forge-core",
  "version": "2.2.0",
  "description": "Core utilities for icon-forge",
  "author": "Xiaobing Zhu <hellozxb252@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hixb/icon-forge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hixb/icon-forge.git",
    "directory": "packages/core"
  },
  "bugs": "https://github.com/hixb/icon-forge/issues",
  "keywords": [
    "icon",
    "icons",
    "icon-library",
    "svg",
    "utilities",
    "typescript"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
